data/
runtime/data/
fulltext-runtime/data/
database-browser-runtime/data/

# Caches
.pytest_cache/
.ruff_cache/
__pycache__/
*.pyc
.eslintcache

# Logs & reports
*.log
npm-debug.log*
gitleaks-report*.json

# Editors & OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Release assets written by scripts/package-release.mjs
release-out/

