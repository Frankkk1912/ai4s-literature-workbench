{
  "name": "ai4s-literature-workbench",
  "version": "0.2.0",
  "description": "Auditable literature retrieval, optional verified OA fulltext, Zotero workflows, and evidence-traced writing.",
  "author": {
    "name": "Frank AI4S Skill contributors",
    "url": "https://github.com/Frankkk1912"
  },
  "homepage": "https://github.com/Frankkk1912/ai4s-literature-workbench",
  "repository": "https://github.com/Frankkk1912/ai4s-literature-workbench",
  "license": "MIT",
  "mcpServers": {
    "ai4s-literature-zotero": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/runtime/dist/index.js"],
      "cwd": "${CLAUDE_PLUGIN_ROOT}",
      "env": {
        "LITERATURE_ZOTERO_MCP_TOOL_PROFILE": "workbench",
        "ZOTEUS_LOCAL": "auto",
        "ZOTEUS_EMBEDDINGS": "off"
      }
    },
    "ai4s-literature-fulltext": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/fulltext-runtime/dist/index.js"],
      "cwd": "${CLAUDE_PLUGIN_ROOT}"
    }
  },
  "keywords": [
    "literature",
    "zotero",
    "evidence",
    "biomedical",
    "research"
  ]
}
